---
import { t, LANGUAGES, type Lang } from '~/i18n/translations';
import { localizedPath } from '~/utils/paths';
import ThemeToggle from '~/components/ThemeToggle.astro';

interface Props {
  lang: Lang;
  pathInLang?: string;
  /** Idiomas em que a página atual existe; demais idiomas levam à home. */
  availableLangs?: Lang[];
}
const { lang, pathInLang = '', availableLangs = [...LANGUAGES] } = Astro.props;

const navItems = [
  { href: localizedPath(lang, 'institucional'), label: t(lang, 'nav.institucional') },
  { href: localizedPath(lang, 'pesquisas'), label: t(lang, 'nav.pesquisas') },
  { href: localizedPath(lang, 'publicacoes'), label: t(lang, 'nav.publicacoes') },
  { href: localizedPath(lang, 'noticias'), label: t(lang, 'nav.noticias') },
  { href: localizedPath(lang, 'equipe'), label: t(lang, 'nav.equipe') },
];

const showLangPicker = LANGUAGES.length > 1;
const logo = `${import.meta.env.BASE_URL}imagens/wp/nepps-logo-secundario-negativo-e1623613930590.png`.replace(/\/+/g, '/');
---

<!-- Barra única roxa como no site original (OnePress: .site-header #2c0963,
     menu #00afef com hover amarelo sobre branco) -->
<header class="sticky top-0 z-30 shadow-sm bg-primary text-primary-content">
  <div class="container mx-auto px-4 flex items-center justify-between gap-4 py-2.5">
    <a href={localizedPath(lang, '')} class="block shrink-0" aria-label="NEPPs — Início">
      <img
        src={logo}
        alt="NEPPs — Núcleo de Estudos de Políticas Públicas"
        width="141"
        height="48"
        class="h-12 w-auto"
      />
    </a>

    <div class="flex items-center gap-1 min-w-0">
      <nav class="hidden lg:flex items-center gap-1 overflow-x-auto" aria-label={t(lang, 'a11y.nav_main')}>
        {
          navItems.map((item) => (
            <a
              href={item.href}
              class="px-3 py-2 text-sm font-semibold uppercase tracking-wide whitespace-nowrap rounded text-secondary transition-colors hover:bg-white hover:text-warning"
            >
              {item.label}
            </a>
          ))
        }
      </nav>

      <a
        href={localizedPath(lang, 'busca')}
        class="btn btn-ghost btn-sm text-secondary hover:bg-white hover:text-warning"
        aria-label={t(lang, 'nav.search')}
      >
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="11" cy="11" r="7"/>
          <line x1="21" y1="21" x2="16.65" y2="16.65"/>
        </svg>
      </a>

      {showLangPicker && (
        <div class="dropdown dropdown-end">
          <button
            class="btn btn-ghost btn-sm text-secondary hover:bg-white hover:text-warning"
            aria-label={t(lang, 'nav.language')}
          >
            {lang.toUpperCase()}
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
              <polyline points="6 9 12 15 18 9"/>
            </svg>
          </button>
          <ul class="dropdown-content menu bg-base-100 text-base-content rounded-box shadow border border-base-300 mt-2 w-36 z-40">
            {LANGUAGES.map((l) => (
              <li>
                <a
                  href={localizedPath(l, availableLangs.includes(l) ? pathInLang : '')}
                  aria-current={l === lang ? 'true' : undefined}
                >
                  {l.toUpperCase()}
                </a>
              </li>
            ))}
          </ul>
        </div>
      )}

      <ThemeToggle lang={lang} />

      <details class="dropdown dropdown-end lg:hidden">
        <summary class="btn btn-ghost btn-sm text-secondary hover:bg-white hover:text-warning" aria-label="Menu">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <line x1="3" y1="6" x2="21" y2="6"/>
            <line x1="3" y1="12" x2="21" y2="12"/>
            <line x1="3" y1="18" x2="21" y2="18"/>
          </svg>
        </summary>
        <ul class="dropdown-content menu bg-base-100 text-base-content rounded-box shadow border border-base-300 mt-2 w-60 z-40">
          {navItems.map((item) => (
            <li>
              <a href={item.href}>{item.label}</a>
            </li>
          ))}
        </ul>
      </details>
    </div>
  </div>
</header>
