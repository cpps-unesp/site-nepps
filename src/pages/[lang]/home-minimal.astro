---
import { getCollection } from 'astro:content';
import BaseLayout from '~/layouts/BaseLayout.astro';
import { LANGUAGES, t, type Lang } from '~/i18n/translations';
import { assetPath, localizedPath } from '~/utils/paths';
import { entrySlug } from '~/utils/content';

export function getStaticPaths() {
  return LANGUAGES.map((lang) => ({ params: { lang } }));
}
const lang = Astro.params.lang as Lang;
const p = (s: string) => localizedPath(lang, s);

const noticias = (await getCollection('noticias', (e) => e.data.lang === lang)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
const [principal, ...resto] = noticias;
const lista = resto.slice(0, 5);
const fmt = (d: Date) => new Intl.DateTimeFormat('pt-BR', { dateStyle: 'long' }).format(d);

const logo = `${import.meta.env.BASE_URL}imagens/wp/nepps-logo-secundario-positivo.png`.replace(/\/+/g, '/');
---

<BaseLayout lang={lang} title="Home — Minimalista (preview)" pathInLang="home-minimal" noindex>
  <!-- HERO claro com a logo (redemoinho) como detalhe -->
  <section class="bg-base-100">
    <div class="container mx-auto px-4 py-20 md:py-28 max-w-3xl text-center">
      <img src={logo} alt="NEPPs" width="360" height="123" class="h-24 md:h-28 w-auto mx-auto" />
      <p class="mt-8 text-lg md:text-xl text-base-content/70 leading-relaxed text-balance">
        {t(lang, 'site.name_full')}
      </p>
      <div class="mt-8 flex flex-wrap justify-center gap-3">
        <a class="btn btn-primary" href={p('institucional')}>{t(lang, 'home.cta_sobre')}</a>
        <a class="btn btn-ghost text-primary" href={p('pesquisas')}>{t(lang, 'home.cta_pesquisas')} →</a>
      </div>
    </div>
  </section>

  <div class="container mx-auto px-4 max-w-3xl">
    <hr class="border-base-300" />
  </div>

  <!-- NOTÍCIA EM DESTAQUE + LISTA ENXUTA -->
  <section class="py-16 md:py-20 bg-base-100">
    <div class="container mx-auto px-4 max-w-3xl">
      {principal && (
        <a href={p(`noticias/${entrySlug(principal)}`)} class="block group">
          <p class="text-[11px] uppercase tracking-[0.2em] font-bold text-accent">Em destaque</p>
          {principal.data.image && (
            <img src={assetPath(principal.data.image)} alt="" class="w-full aspect-[2/1] object-cover rounded-box mt-4" loading="eager" />
          )}
          <h2 class="font-display text-2xl md:text-3xl font-bold leading-tight mt-5 group-hover:text-primary transition-colors">
            {principal.data.title}
          </h2>
          <p class="opacity-60 text-sm mt-2">{fmt(principal.data.date)}</p>
          {principal.data.excerpt && <p class="opacity-80 mt-3">{principal.data.excerpt}</p>}
        </a>
      )}

      <ul class="mt-12 divide-y divide-base-300 list-none p-0">
        {lista.map((n) => (
          <li>
            <a href={p(`noticias/${entrySlug(n)}`)} class="flex items-baseline gap-4 py-4 group">
              <time class="shrink-0 text-xs uppercase tracking-wide opacity-50 w-28">{fmt(n.data.date)}</time>
              <span class="font-display font-semibold leading-snug group-hover:text-primary transition-colors">{n.data.title}</span>
            </a>
          </li>
        ))}
      </ul>

      <div class="mt-10 text-center">
        <a class="btn btn-outline btn-primary" href={p('noticias')}>{t(lang, 'home.news_more')}</a>
      </div>
    </div>
  </section>
</BaseLayout>
