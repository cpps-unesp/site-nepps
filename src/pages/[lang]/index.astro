---
import { getCollection } from 'astro:content';
import BaseLayout from '~/layouts/BaseLayout.astro';
import NoticiaCard from '~/components/NoticiaCard.astro';
import { LANGUAGES, t, type Lang } from '~/i18n/translations';
import { localizedPath } from '~/utils/paths';
import { entrySlug } from '~/utils/content';

export function getStaticPaths() {
  return LANGUAGES.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Lang;

const noticias = (await getCollection('noticias', (e) => e.data.lang === lang)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
// "EM DESTAQUE": notícias marcadas featured (como na home original); fallback: últimas
const destaque = noticias.filter((n) => n.data.featured).slice(0, 4);
const emDestaque = destaque.length > 0 ? destaque : noticias.slice(0, 4);
const ultimas = noticias.slice(0, 3);

const heroBg = `${import.meta.env.BASE_URL}imagens/wp/UNESP_Franca_Main_Entrance_Franca_SP_Brazil_1567685134097.jpg`.replace(/\/+/g, '/');
---

<BaseLayout
  lang={lang}
  title={t(lang, 'site.title')}
  description={t(lang, 'site.tagline')}
  pathInLang=""
>
  <!-- HERO: como no original — foto da UNESP Franca com overlay escuro,
       nome do núcleo centrado e CTAs "Quem somos" / "Notícias" -->
  <section
    class="relative overflow-hidden bg-primary bg-cover bg-center"
    style={`background-image: url('${heroBg}')`}
  >
    <div class="absolute inset-0 bg-black/45" aria-hidden="true"></div>
    <div class="relative container mx-auto px-4 py-28 md:py-40 max-w-4xl text-center text-white">
      <h1 class="font-display text-3xl md:text-5xl font-bold leading-tight text-balance drop-shadow">
        {t(lang, 'site.name_full')}
      </h1>
      <div class="mt-10 flex flex-wrap justify-center gap-3">
        <a class="btn bg-white text-primary border-none hover:bg-base-200" href={localizedPath(lang, 'institucional')}>
          {t(lang, 'home.cta_sobre')}
        </a>
        <a class="btn btn-outline text-white border-white hover:bg-white hover:text-primary" href={localizedPath(lang, 'noticias')}>
          {t(lang, 'nav.noticias')}
        </a>
      </div>
    </div>
  </section>

  <!-- EM DESTAQUE: como a section-services da home original -->
  <section class="py-16 md:py-20 bg-base-100">
    <div class="container mx-auto px-4">
      <div class="text-center">
        <h2 class="section-title text-3xl md:text-4xl text-primary">{t(lang, 'home.featured_title')}</h2>
        <div class="section-divider mx-auto mt-4"></div>
      </div>
      <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-4 mt-12">
        {emDestaque.map((n) => (
          <NoticiaCard
            lang={lang}
            slug={entrySlug(n)}
            title={n.data.title}
            date={n.data.date}
            excerpt={n.data.excerpt}
            image={n.data.image}
          />
        ))}
      </div>
    </div>
  </section>

  <!-- NOTÍCIAS: título e subtítulo da home original -->
  <section class="py-16 md:py-20 bg-base-200">
    <div class="container mx-auto px-4">
      <div class="text-center">
        <h2 class="section-title text-3xl md:text-4xl text-primary">{t(lang, 'news.title')}</h2>
        <div class="section-divider mx-auto mt-4"></div>
        <p class="mt-4 opacity-80">{t(lang, 'home.news_subtitle')}</p>
      </div>

      {ultimas.length === 0 ? (
        <p class="text-center opacity-70 mt-10">{t(lang, 'news.empty')}</p>
      ) : (
        <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3 mt-12">
          {ultimas.map((n) => (
            <NoticiaCard
              lang={lang}
              slug={entrySlug(n)}
              title={n.data.title}
              date={n.data.date}
              excerpt={n.data.excerpt}
              image={n.data.image}
            />
          ))}
        </div>
      )}

      <div class="text-center mt-10">
        <a class="btn btn-primary" href={localizedPath(lang, 'noticias')}>
          {t(lang, 'home.news_more')}
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
